// ============================================================
// BMI Health Tracker — Docker Deploy Pipeline (SL#6)
// Pulls RC images from ECR, deploys to AWS Ubuntu 24.04 EC2
// using Docker Compose.
//
// Smart idempotent logic:
//   Running containers → rolling update (zero-downtime)
//   No containers      → fresh deployment
//
// Job name: bmi-deploy-docker
//
// Required Jenkins Credentials:
//   aws-credentials  → Username with password
//                      Username = AWS_ACCESS_KEY_ID
//                      Password = AWS_SECRET_ACCESS_KEY
//   bmi-db-password  → Secret text (strong PostgreSQL password)
//   ec2-ssh-key      → SSH Username with private key (EC2 .pem)
//
// Required Jenkins Plugins:
//   Credentials Binding (provides sshUserPrivateKey), Email Extension
//
// Prerequisite:
//   Run bmi-rc-pipeline FIRST to build and push images to ECR.
//   Note the build number — you will enter it as RC_BUILD_NUMBER.
// ============================================================

pipeline {
    agent { label 'built-in' }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'RC_BUILD_NUMBER',
            defaultValue: '',
            description: 'RC pipeline build number to deploy (e.g. 42) — required'
        )
        string(
            name: 'EC2_HOST',
            defaultValue: '',
            description: 'EC2 Public IP or hostname — required'
        )
        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'SSH username on the EC2 instance'
        )
        string(
            name: 'SSH_CREDENTIALS_ID',
            defaultValue: 'ec2-ssh-key',
            description: 'Jenkins Credential ID for EC2 SSH private key'
        )
        string(
            name: 'NOTIFY_EMAIL',
            defaultValue: '',
            description: 'Email address for deployment notifications — required'
        )
        string(
            name: 'AWS_REGION',
            defaultValue: 'ap-south-1',
            description: 'AWS region where ECR repositories reside'
        )
    }

    stages {

        // --------------------------------------------------------
        // Stage 1: Validate Parameters
        // --------------------------------------------------------
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.RC_BUILD_NUMBER?.trim()) {
                        error("RC_BUILD_NUMBER is required. Run bmi-rc-pipeline first and use its build number.")
                    }
                    if (!params.EC2_HOST?.trim()) {
                        error("EC2_HOST is required. Provide the EC2 public IP or hostname.")
                    }
                    if (!params.NOTIFY_EMAIL?.trim()) {
                        error("NOTIFY_EMAIL is required for deployment notifications.")
                    }
                    echo "Deploying RC Build #${params.RC_BUILD_NUMBER} to ${params.EC2_USER}@${params.EC2_HOST}"
                }
            }
        }

        // --------------------------------------------------------
        // Stage 2: Resolve Build Info
        // Reconstructs ECR image URIs from RC_BUILD_NUMBER directly —
        // avoids the Copy Artifact plugin (not installed on this master)
        // --------------------------------------------------------
        stage('Resolve Build Info') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'aws-credentials',
                        usernameVariable: 'AWS_ACCESS_KEY_ID',
                        passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                    )]) {
                        def accountId = sh(
                            script: """
                                AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
                                AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
                                AWS_DEFAULT_REGION=${params.AWS_REGION} \
                                aws sts get-caller-identity \
                                    --query Account \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()

                        env.ECR_REGISTRY     = "${accountId}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"
                        env.IMAGE_TAG        = "rc-${params.RC_BUILD_NUMBER}"
                        env.FRONTEND_IMAGE   = "${env.ECR_REGISTRY}/bmi-frontend:${env.IMAGE_TAG}"
                        env.BACKEND_IMAGE    = "${env.ECR_REGISTRY}/bmi-backend:${env.IMAGE_TAG}"
                        env.GIT_COMMIT_SHA   = 'n/a'
                        env.RC_TIMESTAMP     = 'n/a'

                        echo "============================================"
                        echo " Build info resolved"
                        echo " RC Build #    : ${params.RC_BUILD_NUMBER}"
                        echo " Image Tag     : ${env.IMAGE_TAG}"
                        echo " Frontend      : ${env.FRONTEND_IMAGE}"
                        echo " Backend       : ${env.BACKEND_IMAGE}"
                        echo " ECR Registry  : ${env.ECR_REGISTRY}"
                        echo "============================================"
                    }
                }
            }
        }

        // --------------------------------------------------------
        // Stage 3: Checkout (for docker-compose.prod.yml)
        // We need the docker-compose file from the repo to SCP to EC2
        // --------------------------------------------------------
        stage('Checkout') {
            steps {
                checkout scm
                echo "Repository checked out — docker-compose.prod.yml available for transfer"
            }
        }

        // --------------------------------------------------------
        // Stage 4: Prepare EC2
        // Installs Docker and AWS CLI if not present (idempotent)
        // --------------------------------------------------------
        stage('Prepare EC2') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: params.SSH_CREDENTIALS_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                    sh """
                        ssh -i \$SSH_KEY -o StrictHostKeyChecking=no \
                            -o ConnectTimeout=30 \
                            ${params.EC2_USER}@${params.EC2_HOST} bash -s << 'REMOTE_SCRIPT'
                            set -euo pipefail

                            # --- Install Docker if not present ---
                            if command -v docker &>/dev/null; then
                                echo "[EXISTS] Docker already installed: \$(docker --version)"
                            else
                                echo "[INSTALL] Installing Docker CE..."
                                sudo apt-get update -qq
                                sudo apt-get install -y ca-certificates curl gnupg
                                sudo install -m 0755 -d /etc/apt/keyrings
                                curl -fsSL https://download.docker.com/linux/ubuntu/gpg | \
                                    sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
                                sudo chmod a+r /etc/apt/keyrings/docker.gpg
                                echo "deb [arch=\$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
                                    https://download.docker.com/linux/ubuntu \
                                    \$(. /etc/os-release && echo \$VERSION_CODENAME) stable" | \
                                    sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
                                sudo apt-get update -qq
                                sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
                                sudo usermod -aG docker ubuntu
                                sudo systemctl enable --now docker
                                echo "[OK] Docker installed: \$(docker --version)"
                            fi

                            # --- Install AWS CLI v2 if not present ---
                            if command -v aws &>/dev/null; then
                                echo "[EXISTS] AWS CLI already installed: \$(aws --version)"
                            else
                                echo "[INSTALL] Installing AWS CLI v2..."
                                sudo apt-get install -y unzip
                                curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
                                    -o /tmp/awscliv2.zip
                                unzip -q /tmp/awscliv2.zip -d /tmp
                                sudo /tmp/aws/install
                                rm -rf /tmp/aws /tmp/awscliv2.zip
                                echo "[OK] AWS CLI installed: \$(aws --version)"
                            fi

                            # --- Create app directory ---
                            mkdir -p /home/ubuntu/bmi-docker
                            echo "[OK] EC2 preparation complete"
REMOTE_SCRIPT
                    """
                }
            }
        }

        // --------------------------------------------------------
        // Stage 5: Deploy to EC2
        // Transfers compose file, writes .env, pulls images, deploys
        // Rolling update if containers are running; fresh if not
        // --------------------------------------------------------
        stage('Deploy to EC2') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: params.SSH_CREDENTIALS_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'aws-credentials',
                            usernameVariable: 'AWS_KEY_ID',
                            passwordVariable: 'AWS_KEY_SECRET'
                        ),
                        string(
                            credentialsId: 'bmi-db-password',
                            variable: 'DB_PASSWORD'
                        )
                    ]) {
                        // Transfer docker-compose.prod.yml to EC2
                        sh """
                            scp -i \$SSH_KEY -o StrictHostKeyChecking=no \
                                docker-compose.prod.yml \
                                ${params.EC2_USER}@${params.EC2_HOST}:/home/ubuntu/bmi-docker/docker-compose.prod.yml
                            echo "docker-compose.prod.yml transferred to EC2"
                        """

                        // Also transfer DB init SQL scripts for first run
                        sh """
                            ssh -i \$SSH_KEY -o StrictHostKeyChecking=no \
                                ${params.EC2_USER}@${params.EC2_HOST} \
                                'mkdir -p /home/ubuntu/bmi-docker/migrations'

                            scp -i \$SSH_KEY -o StrictHostKeyChecking=no \
                                backend/migrations/001_create_measurements.sql \
                                ${params.EC2_USER}@${params.EC2_HOST}:/home/ubuntu/bmi-docker/migrations/01-create_measurements.sql

                            scp -i \$SSH_KEY -o StrictHostKeyChecking=no \
                                backend/migrations/002_add_measurement_date.sql \
                                ${params.EC2_USER}@${params.EC2_HOST}:/home/ubuntu/bmi-docker/migrations/02-add_measurement_date.sql

                            echo "Migration SQL files transferred"
                        """

                        sh """
                            ssh -i \$SSH_KEY -o StrictHostKeyChecking=no \
                                ${params.EC2_USER}@${params.EC2_HOST} bash -s << REMOTE_SCRIPT
                            set -euo pipefail
                            APP_DIR=/home/ubuntu/bmi-docker

                            echo "=== Writing .env file ==="
                            cat > \\\${APP_DIR}/.env << ENVEOF
IMAGE_TAG=${env.IMAGE_TAG}
ECR_REGISTRY=${env.ECR_REGISTRY}
FRONTEND_IMAGE=${env.FRONTEND_IMAGE}
BACKEND_IMAGE=${env.BACKEND_IMAGE}
DATABASE_URL=postgresql://bmi_user:${DB_PASSWORD}@db:5432/bmidb
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://${params.EC2_HOST}
POSTGRES_DB=bmidb
POSTGRES_USER=bmi_user
POSTGRES_PASSWORD=${DB_PASSWORD}
AWS_REGION=${params.AWS_REGION}
ENVEOF
                            echo ".env written"

                            echo "=== ECR Login on EC2 ==="
                            export AWS_ACCESS_KEY_ID=${AWS_KEY_ID}
                            export AWS_SECRET_ACCESS_KEY=${AWS_KEY_SECRET}
                            export AWS_DEFAULT_REGION=${params.AWS_REGION}
                            aws ecr get-login-password --region ${params.AWS_REGION} | \
                                docker login --username AWS --password-stdin ${env.ECR_REGISTRY}
                            echo "ECR login successful"

                            echo "=== Checking container status ==="
                            cd \\\${APP_DIR}
                            RUNNING=\\\$(docker compose -f docker-compose.prod.yml ps --services --filter status=running 2>/dev/null | wc -l || echo 0)
                            echo "Running services count: \\\${RUNNING}"

                            if [ "\\\${RUNNING}" -gt "0" ]; then
                                echo "=== [ROLLING UPDATE] Containers running — pulling new images ==="
                                docker compose -f docker-compose.prod.yml pull
                                docker compose -f docker-compose.prod.yml up -d --remove-orphans
                                echo "Rolling update complete"
                            else
                                echo "=== [FRESH DEPLOY] No containers running — starting fresh ==="
                                docker compose -f docker-compose.prod.yml pull
                                docker compose -f docker-compose.prod.yml up -d
                                echo "Fresh deployment complete"
                            fi

                            echo "=== Container status ==="
                            docker compose -f docker-compose.prod.yml ps
REMOTE_SCRIPT
                        """
                    }
                }
            }
        }

        // --------------------------------------------------------
        // Stage 6: Health Check
        // --------------------------------------------------------
        stage('Health Check') {
            steps {
                script {
                    withCredentials([sshUserPrivateKey(credentialsId: params.SSH_CREDENTIALS_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')]) {
                        sh """
                            echo "Waiting 15 seconds for containers to fully start..."
                            sleep 15

                            ssh -i \$SSH_KEY -o StrictHostKeyChecking=no \
                                ${params.EC2_USER}@${params.EC2_HOST} '
                                set -euo pipefail
                                echo "=== Docker Compose Health Check ==="

                                echo "--- Container Status ---"
                                docker compose -f /home/ubuntu/bmi-docker/docker-compose.prod.yml ps

                                echo ""
                                echo "--- Frontend Health Check (port 80) ---"
                                HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" --retry 3 --retry-delay 3 http://localhost)
                                if [ "\$HTTP_CODE" = "200" ]; then
                                    echo "[OK] Frontend responding — HTTP \$HTTP_CODE"
                                else
                                    echo "[FAIL] Frontend returned HTTP \$HTTP_CODE"
                                    docker compose -f /home/ubuntu/bmi-docker/docker-compose.prod.yml logs frontend --tail 20
                                    exit 1
                                fi

                                echo ""
                                echo "--- Backend API Health Check ---"
                                # Port 3000 is not published to the host (internal-only by design) — check the containers Docker healthcheck status instead
                                BACKEND_STATUS=\$(docker inspect --format='{{.State.Health.Status}}' bmi-backend)
                                if [ "\$BACKEND_STATUS" = "healthy" ]; then
                                    echo "[OK] Backend container healthy"
                                else
                                    echo "[FAIL] Backend container status: \$BACKEND_STATUS"
                                    docker compose -f /home/ubuntu/bmi-docker/docker-compose.prod.yml logs backend --tail 20
                                    exit 1
                                fi

                                echo ""
                                echo "=== All health checks passed ==="
                            '
                        """
                    }
                }
            }
        }

    } // end stages

    post {
        success {
            script {
                echo "============================================================"
                echo " [SUCCESS] Docker deployment complete"
                echo " RC Build  : #${params.RC_BUILD_NUMBER}"
                echo " Image Tag : ${env.IMAGE_TAG}"
                echo " Target    : ${params.EC2_USER}@${params.EC2_HOST}"
                echo " App URL   : http://${params.EC2_HOST}"
                echo ""
                echo " To rollback: re-run this pipeline with an older RC_BUILD_NUMBER"
                echo "============================================================"

                // Email notifications disabled — SMTP not configured (see Manage Jenkins > Extended E-mail Notification)
                /*
                try {
                    emailext(
                        from: 'Jenkins CI <sarowar.alam@gmail.com>',
                        to: params.NOTIFY_EMAIL,
                        subject: "[DEPLOY SUCCESS] BMI Health Tracker - ${env.IMAGE_TAG} live on ${params.EC2_HOST}",
                        mimeType: 'text/html',
                        body: """
                            <html><body style="margin:0;padding:0;font-family:Arial,sans-serif;background:#f5f5f5;">
                            <table width="600" cellpadding="0" cellspacing="0" style="margin:20px auto;background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1);">
                              <tr><td style="background:#1a6fa8;padding:20px 24px;">
                                <h2 style="margin:0;color:#fff;">&#10004; Docker Deployment Successful</h2>
                                <p style="margin:4px 0 0;color:#c8e8ff;font-size:13px;">BMI Health Tracker &mdash; ${env.IMAGE_TAG}</p>
                              </td></tr>
                              <tr><td style="padding:24px;">
                                <table width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;width:140px;"><b>RC Build #</b></td><td style="border:1px solid #ddd;">${params.RC_BUILD_NUMBER}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Image Tag</b></td><td style="border:1px solid #ddd;">${env.IMAGE_TAG}</td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>Git Commit</b></td><td style="border:1px solid #ddd;">${env.GIT_COMMIT_SHA}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Built At</b></td><td style="border:1px solid #ddd;">${env.RC_TIMESTAMP}</td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>Target</b></td><td style="border:1px solid #ddd;">${params.EC2_USER}@${params.EC2_HOST}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Frontend Image</b></td><td style="border:1px solid #ddd;">${env.FRONTEND_IMAGE}</td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>Backend Image</b></td><td style="border:1px solid #ddd;">${env.BACKEND_IMAGE}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>App URL</b></td><td style="border:1px solid #ddd;"><a href="http://${params.EC2_HOST}" style="color:#1a73e8;">http://${params.EC2_HOST}</a></td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>API URL</b></td><td style="border:1px solid #ddd;"><a href="http://${params.EC2_HOST}/api/measurements" style="color:#1a73e8;">http://${params.EC2_HOST}/api/measurements</a></td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Console</b></td><td style="border:1px solid #ddd;"><a href="${BUILD_URL}console" style="color:#1a73e8;">View Console Output</a></td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>Rollback</b></td><td style="border:1px solid #ddd;">Re-run bmi-deploy-docker with an older RC_BUILD_NUMBER</td></tr>
                                </table>
                              </td></tr>
                              <tr><td style="padding:12px 24px;background:#f5f5f5;font-size:12px;color:#888;border-top:1px solid #eee;">Sent by Jenkins CI via AWS SES &bull; ap-south-1</td></tr>
                            </table>
                            </body></html>
                        """
                    )
                    echo "Email notification sent to: ${params.NOTIFY_EMAIL}"
                } catch (emailEx) {
                    echo "[WARN] Email notification failed — check SES SMTP config in Manage Jenkins > System > Extended E-mail Notification. Error: ${emailEx.message}"
                }
                */
            }
        }

        failure {
            script {
                echo "[FAILURE] Docker deployment failed — RC #${params.RC_BUILD_NUMBER} — review console output"

                // Email notifications disabled — SMTP not configured (see Manage Jenkins > Extended E-mail Notification)
                /*
                try {
                    emailext(
                        from: 'Jenkins CI <sarowar.alam@gmail.com>',
                        to: params.NOTIFY_EMAIL,
                        subject: "[DEPLOY FAILED] BMI Health Tracker - RC #${params.RC_BUILD_NUMBER} failed on ${params.EC2_HOST}",
                        mimeType: 'text/html',
                        body: """
                            <html><body style="margin:0;padding:0;font-family:Arial,sans-serif;background:#f5f5f5;">
                            <table width="600" cellpadding="0" cellspacing="0" style="margin:20px auto;background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1);">
                              <tr><td style="background:#c0392b;padding:20px 24px;">
                                <h2 style="margin:0;color:#fff;">&#10008; Docker Deployment Failed</h2>
                                <p style="margin:4px 0 0;color:#ffc8c8;font-size:13px;">BMI Health Tracker &mdash; RC #${params.RC_BUILD_NUMBER}</p>
                              </td></tr>
                              <tr><td style="padding:24px;">
                                <table width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;width:140px;"><b>RC Build #</b></td><td style="border:1px solid #ddd;">${params.RC_BUILD_NUMBER}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Image Tag</b></td><td style="border:1px solid #ddd;">${env.IMAGE_TAG ?: 'unknown'}</td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>Target</b></td><td style="border:1px solid #ddd;">${params.EC2_HOST}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Console</b></td><td style="border:1px solid #ddd;"><a href="${BUILD_URL}console" style="color:#1a73e8;">View Console Output</a></td></tr>
                                </table>
                                <p style="font-size:13px;color:#555;margin-top:16px;">Review the console output for full error details.</p>
                              </td></tr>
                              <tr><td style="padding:12px 24px;background:#f5f5f5;font-size:12px;color:#888;border-top:1px solid #eee;">Sent by Jenkins CI via AWS SES &bull; ap-south-1</td></tr>
                            </table>
                            </body></html>
                        """
                    )
                } catch (emailEx) {
                    echo "[WARN] Email notification failed — check SES SMTP config in Manage Jenkins > System > Extended E-mail Notification. Error: ${emailEx.message}"
                }
                */
            }
        }

        always {
            echo "Docker Deploy done | RC: #${params.RC_BUILD_NUMBER} | Tag: ${env.IMAGE_TAG ?: 'N/A'} | Target: ${params.EC2_HOST ?: 'N/A'} | Node: ${NODE_NAME}"
        }
    }
}
