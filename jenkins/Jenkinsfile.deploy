// ============================================================
// BMI Health Tracker — Bare-Metal Deploy Pipeline (SL#5)
// Deploys to AWS Ubuntu 24.04 EC2 via SSH
//
// Smart idempotent logic:
//   Run 1 (fresh EC2) → installs everything from scratch
//   Run 2+ (existing)  → backs up current deployment, pulls latest, redeploys
//
// Required Jenkins Credentials:
//   ec2-ssh-key        → SSH Username with private key (EC2 .pem file)
//   bmi-database-url   → Secret text (postgresql://bmi_user:PASS@localhost:5432/bmidb)
//
// Required Plugins:
//   SSH Agent, Email Extension, Credentials Binding
// ============================================================

pipeline {
    agent { label 'built-in' }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 40, unit: 'MINUTES')
        ansiColor('xterm')
    }

    parameters {
        string(
            name: 'EC2_HOST',
            defaultValue: '',
            description: 'EC2 Public IP or hostname (required)'
        )
        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'SSH username on the EC2 instance'
        )
        string(
            name: 'SSH_CREDENTIALS_ID',
            defaultValue: 'ec2-ssh-key',
            description: 'Jenkins Credential ID containing the EC2 SSH private key'
        )
        string(
            name: 'NOTIFY_EMAIL',
            defaultValue: '',
            description: 'Email address for deployment notifications (required)'
        )
        string(
            name: 'FROM_EMAIL',
            defaultValue: 'sarowar.alam@gmail.com',
            description: 'SES verified sender email address'
        )
    }

    environment {
        APP_DIR        = '/home/ubuntu/bmi-health-tracker'
        BACKUP_DIR     = '/home/ubuntu/backups'
        WEBROOT        = '/var/www/bmi-health-tracker'
        GIT_REPO       = 'https://github.com/sarowar-alam/devops-jenkins-masterclass.git'
        MARKER         = '/home/ubuntu/bmi-health-tracker/.deployed'
        AWS_SES_REGION = 'ap-south-1'
    }

    stages {

        // --------------------------------------------------------
        // Stage 1: Checkout
        // --------------------------------------------------------
        stage('Checkout') {
            steps {
                checkout scm
                echo "Source code checked out on Jenkins master — Build #${BUILD_NUMBER}"
            }
        }

        // --------------------------------------------------------
        // Stage 2: Validate Parameters
        // --------------------------------------------------------
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.EC2_HOST?.trim()) {
                        error("EC2_HOST is required. Provide the EC2 public IP or hostname.")
                    }
                    if (!params.NOTIFY_EMAIL?.trim()) {
                        error("NOTIFY_EMAIL is required. Provide an email address for notifications.")
                    }
                    echo "Target server  : ${params.EC2_USER}@${params.EC2_HOST}"
                    echo "Notification   : ${params.NOTIFY_EMAIL}"
                    echo "Credential ID  : ${params.SSH_CREDENTIALS_ID}"
                }
            }
        }

        // --------------------------------------------------------
        // Stage 3: Pre-flight Check
        // Detects whether this is a fresh deploy or an update
        // --------------------------------------------------------
        stage('Pre-flight Check') {
            steps {
                script {
                    sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                        def result = sh(
                            script: """
                                ssh -o StrictHostKeyChecking=no \
                                    -o ConnectTimeout=30 \
                                    ${params.EC2_USER}@${params.EC2_HOST} \
                                    'test -f ${MARKER} && echo EXISTS || echo FRESH'
                            """,
                            returnStdout: true
                        ).trim()

                        env.DEPLOY_MODE = result
                        echo "============================================"
                        echo " Deployment mode : ${env.DEPLOY_MODE}"
                        if (env.DEPLOY_MODE == 'FRESH') {
                            echo " Action          : Full installation"
                        } else {
                            echo " Action          : Backup + update"
                        }
                        echo "============================================"
                    }
                }
            }
        }

        // --------------------------------------------------------
        // Stage 4A: Fresh Install
        // Runs ONLY when no .deployed marker found
        // --------------------------------------------------------
        stage('Fresh Install') {
            when {
                expression { env.DEPLOY_MODE == 'FRESH' }
            }
            steps {
                sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                    withCredentials([
                        string(credentialsId: 'bmi-database-url', variable: 'DATABASE_URL')
                    ]) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} bash -s << 'REMOTE_SCRIPT'
                                set -euo pipefail
                                echo "=== [FRESH INSTALL] Starting ==="

                                # System update
                                sudo apt-get update -qq
                                sudo apt-get install -y git curl

                                # Node.js 20.x via NodeSource
                                if ! command -v node &>/dev/null; then
                                    echo "Installing Node.js 20.x..."
                                    curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -
                                    sudo apt-get install -y nodejs
                                fi
                                echo "Node.js: \$(node --version) | npm: \$(npm --version)"

                                # Nginx
                                sudo apt-get install -y nginx
                                sudo systemctl enable nginx

                                # PM2 globally
                                sudo npm install -g pm2

                                # PostgreSQL 14 via official PGDG repo
                                # (Ubuntu 24.04 default repos only ship PG16 — PGDG has PG14)
                                if ! command -v psql &>/dev/null; then
                                    echo "Installing PostgreSQL 14 via PGDG..."
                                    sudo apt-get install -y gnupg2 wget
                                    sudo install -d /usr/share/postgresql-common/pgdg
                                    sudo wget -q -O /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
                                        https://www.postgresql.org/media/keys/ACCC4CF8.asc
                                    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt noble-pgdg main" \
                                        | sudo tee /etc/apt/sources.list.d/pgdg.list
                                    sudo apt-get update -qq
                                    sudo apt-get install -y postgresql-14 postgresql-contrib-14
                                fi
                                sudo systemctl enable postgresql
                                sudo systemctl start postgresql

                                # Create backup directory
                                mkdir -p ${BACKUP_DIR}

                                echo "=== [FRESH INSTALL] System packages ready ==="
REMOTE_SCRIPT
                        """

                        sh """
                            ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} bash -s << 'REMOTE_SCRIPT'
                                set -euo pipefail

                                # Clone repository
                                echo "=== [FRESH INSTALL] Cloning repository ==="
                                sudo rm -rf ${APP_DIR}
                                git clone ${GIT_REPO} ${APP_DIR}
                                echo "Cloned to: ${APP_DIR}"
                                cd ${APP_DIR}
                                git log --oneline -3

                                echo "=== [FRESH INSTALL] Setting up database ==="
                                sudo systemctl start postgresql

                                # Extract password from DATABASE_URL (Groovy expands ${DATABASE_URL} at build time)
                                DB_PASS=\$(python3 -c "from urllib.parse import urlparse; print(urlparse('${DATABASE_URL}').password)")

                                # Create user if not exists
                                if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='bmi_user'" | grep -q 1; then
                                    sudo -u postgres psql -c "CREATE USER bmi_user WITH PASSWORD '\$DB_PASS';"
                                    echo "User bmi_user created"
                                fi

                                # Create database if not exists
                                if ! sudo -u postgres psql -lqt | cut -d '|' -f 1 | grep -qw bmidb; then
                                    sudo -u postgres psql -c "CREATE DATABASE bmidb OWNER bmi_user;"
                                    echo "Database bmidb created"
                                fi

                                # Grant privileges
                                sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE bmidb TO bmi_user;"
                                sudo -u postgres psql -d bmidb -c "GRANT ALL ON SCHEMA public TO bmi_user;" 2>/dev/null || true
                                sudo -u postgres psql -d bmidb -c "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO bmi_user;" 2>/dev/null || true
                                sudo -u postgres psql -d bmidb -c "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO bmi_user;" 2>/dev/null || true

                                # Allow password auth for bmi_user in pg_hba.conf
                                PG_HBA=\$(sudo -u postgres psql -tAc "SHOW hba_file" | tr -d '[:space:]')
                                if ! sudo grep -q "bmi_user" "\$PG_HBA"; then
                                    printf "\nhost bmidb bmi_user 127.0.0.1/32 scram-sha-256\nhost bmidb bmi_user ::1/128 scram-sha-256\n" | sudo tee -a "\$PG_HBA"
                                    sudo systemctl reload postgresql
                                    echo "pg_hba.conf updated for bmi_user"
                                fi

                                # Run migrations — copy to /tmp first so postgres user can read them
                                # (postgres user cannot traverse /home/ubuntu/ — Permission denied)
                                cp ${APP_DIR}/backend/migrations/001_create_measurements.sql /tmp/
                                cp ${APP_DIR}/backend/migrations/002_add_measurement_date.sql /tmp/
                                sudo -u postgres psql -d bmidb -f /tmp/001_create_measurements.sql
                                sudo -u postgres psql -d bmidb -f /tmp/002_add_measurement_date.sql
                                rm -f /tmp/001_create_measurements.sql /tmp/002_add_measurement_date.sql
                                echo "Migrations complete"
REMOTE_SCRIPT
                        """

                        // Inject DATABASE_URL from Jenkins credential into the remote .env
                        sh """
                            ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} '
                                set -euo pipefail

                                echo "=== [FRESH INSTALL] Configuring backend ==="
                                cd ${APP_DIR}/backend
                                npm install --omit=dev

                                # Write .env file
                                cat > ${APP_DIR}/backend/.env << EOF
PORT=3000
DATABASE_URL=${DATABASE_URL}
NODE_ENV=production
FRONTEND_URL=http://${params.EC2_HOST}
EOF
                                echo ".env created"

                                # Start with PM2
                                pm2 start ecosystem.config.js
                                pm2 save
                                sudo env PATH=\$PATH:/usr/bin pm2 startup systemd -u ubuntu --hp /home/ubuntu
                                echo "PM2 started — bmi-backend"

                                echo "=== [FRESH INSTALL] Building frontend ==="
                                cd ${APP_DIR}/frontend
                                npm install
                                npm run build
                                echo "Frontend built — dist/ ready"

                                echo "=== [FRESH INSTALL] Deploying frontend to Nginx ==="
                                sudo mkdir -p ${WEBROOT}
                                sudo cp -r ${APP_DIR}/frontend/dist/* ${WEBROOT}/
                                sudo chown -R www-data:www-data ${WEBROOT}

                                # Write Nginx virtual host config
                                sudo tee /etc/nginx/sites-available/bmi-health-tracker > /dev/null << NGINXEOF
server {
    listen 80;
    server_name _;

    root ${WEBROOT};
    index index.html;

    # React SPA routing — serve index.html for all non-file routes
    location / {
        try_files \\\$uri \\\$uri/ /index.html;
    }

    # Proxy API requests to Node.js backend
    location /api {
        proxy_pass         http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              \\\$host;
        proxy_set_header   X-Real-IP         \\\$remote_addr;
        proxy_set_header   X-Forwarded-For   \\\$proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
        proxy_read_timeout 60s;
    }
}
NGINXEOF

                                sudo ln -sf /etc/nginx/sites-available/bmi-health-tracker \
                                            /etc/nginx/sites-enabled/bmi-health-tracker
                                sudo rm -f /etc/nginx/sites-enabled/default
                                sudo nginx -t
                                sudo systemctl reload nginx
                                echo "Nginx configured and reloaded"

                                # Write deployment marker
                                echo "Deployed: \$(date -u +%Y-%m-%dT%H:%M:%SZ) | Build: ${BUILD_NUMBER} | Mode: FRESH" \
                                    > ${MARKER}
                                echo "=== [FRESH INSTALL] Complete ==="
                            '
                        """
                    }
                }
            }
        }

        // --------------------------------------------------------
        // Stage 4B: Update Existing Deployment
        // Runs ONLY when .deployed marker exists
        // --------------------------------------------------------
        stage('Update Existing Deployment') {
            when {
                expression { env.DEPLOY_MODE == 'EXISTS' }
            }
            steps {
                sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} '
                            set -euo pipefail
                            TIMESTAMP=\$(date +%Y%m%d-%H%M%S)
                            BACKUP_PATH=${BACKUP_DIR}/bmi-\${TIMESTAMP}

                            echo "=== [UPDATE] Creating backup at \${BACKUP_PATH} ==="
                            mkdir -p \${BACKUP_PATH}

                            # Backup current source directories
                            cp -r ${APP_DIR}/backend/src   \${BACKUP_PATH}/backend-src   2>/dev/null || true
                            cp -r ${APP_DIR}/frontend/src  \${BACKUP_PATH}/frontend-src  2>/dev/null || true

                            # Backup current served frontend build
                            sudo cp -r ${WEBROOT} \${BACKUP_PATH}/dist-backup 2>/dev/null || true

                            # Record what is being backed up
                            echo "Backup of build: \$(cat ${MARKER} 2>/dev/null || echo unknown)" \
                                > \${BACKUP_PATH}/backup-info.txt

                            echo "Backup complete: \${BACKUP_PATH}"

                            echo "=== [UPDATE] Pulling latest code ==="
                            cd ${APP_DIR}
                            git fetch origin
                            git reset --hard origin/main
                            echo "Updated to: \$(git log --oneline -1)"

                            echo "=== [UPDATE] Updating backend dependencies ==="
                            cd ${APP_DIR}/backend
                            npm install --omit=dev

                            echo "=== [UPDATE] Rebuilding frontend ==="
                            cd ${APP_DIR}/frontend
                            npm install
                            npm run build
                            echo "Frontend rebuilt"

                            echo "=== [UPDATE] Deploying new frontend build ==="
                            sudo cp -r ${APP_DIR}/frontend/dist/* ${WEBROOT}/
                            sudo chown -R www-data:www-data ${WEBROOT}

                            echo "=== [UPDATE] Applying migrations ==="
                            cp ${APP_DIR}/backend/migrations/001_create_measurements.sql /tmp/
                            cp ${APP_DIR}/backend/migrations/002_add_measurement_date.sql /tmp/
                            sudo -u postgres psql -d bmidb -f /tmp/001_create_measurements.sql
                            sudo -u postgres psql -d bmidb -f /tmp/002_add_measurement_date.sql
                            rm -f /tmp/001_create_measurements.sql /tmp/002_add_measurement_date.sql
                            echo "Migrations applied"

                            echo "=== [UPDATE] Restarting backend ==="
                            pm2 restart bmi-backend
                            echo "PM2 restart: bmi-backend done"

                            echo "=== [UPDATE] Reloading Nginx ==="
                            sudo nginx -t
                            sudo systemctl reload nginx
                            echo "Nginx reloaded"

                            # Update deployment marker
                            echo "Deployed: \$(date -u +%Y-%m-%dT%H:%M:%SZ) | Build: ${BUILD_NUMBER} | Mode: UPDATE | Backup: \${BACKUP_PATH}" \
                                > ${MARKER}

                            echo "=== [UPDATE] Complete ==="
                        '
                    """
                }
            }
        }

        // --------------------------------------------------------
        // Stage 5: Health Check
        // --------------------------------------------------------
        stage('Health Check') {
            steps {
                script {
                    sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                        sh """
                            echo "Waiting 15 seconds for services to stabilise..."
                            sleep 15

                            ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} '
                                set -euo pipefail
                                echo "=== Health Checks ==="

                                echo "--- Frontend (Nginx port 80) ---"
                                HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" http://localhost)
                                if [ "\$HTTP_CODE" = "200" ]; then
                                    echo "[OK] Frontend responding — HTTP \$HTTP_CODE"
                                else
                                    echo "[FAIL] Frontend returned HTTP \$HTTP_CODE"
                                    exit 1
                                fi

                                echo "--- Backend API (port 3000) ---"
                                API_CODE=\$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/api/measurements)
                                if [ "\$API_CODE" = "200" ]; then
                                    echo "[OK] Backend API responding — HTTP \$API_CODE"
                                else
                                    echo "[FAIL] Backend API returned HTTP \$API_CODE"
                                    exit 1
                                fi

                                echo "--- PM2 Process Status ---"
                                pm2 status

                                echo "--- PostgreSQL Status ---"
                                sudo systemctl is-active postgresql && echo "[OK] PostgreSQL running" || echo "[FAIL] PostgreSQL not running"

                                echo "=== All health checks passed ==="
                            '
                        """
                    }
                }
            }
        }

    } // end stages

    // --------------------------------------------------------
    // Post Actions — Notifications
    // --------------------------------------------------------
    post {
        success {
            script {
                echo "============================================================"
                echo " [SUCCESS] Deployment complete"
                echo " Build     : #${BUILD_NUMBER}"
                echo " Mode      : ${env.DEPLOY_MODE}"
                echo " Target    : ${params.EC2_USER}@${params.EC2_HOST}"
                echo " App URL   : http://${params.EC2_HOST}"
                echo "============================================================"

                try {
                    sh """
                        cat > /tmp/bmi_ses_msg.json << 'SESEOF'
{"Subject":{"Data":"[SUCCESS] BMI Health Tracker — Build #${BUILD_NUMBER} Deployed","Charset":"UTF-8"},"Body":{"Text":{"Data":"Deployment Successful\\nJob: ${JOB_NAME}\\nBuild: #${BUILD_NUMBER}\\nMode: ${env.DEPLOY_MODE}\\nTarget: ${params.EC2_HOST}\\nApp URL: http://${params.EC2_HOST}\\nConsole: ${BUILD_URL}console","Charset":"UTF-8"},"Html":{"Data":"<html><body style='margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Arial,sans-serif;background:#eef2f7;'><table width='100%' cellpadding='0' cellspacing='0'><tr><td align='center' style='padding:30px 20px;'><table width='580' cellpadding='0' cellspacing='0' style='background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.09);'><tr><td style='background:#1a6b2f;padding:28px 36px;'><table width='100%'><tr><td style='font-size:32px;width:48px;'>&#9989;</td><td style='padding-left:14px;'><h1 style='margin:0;color:#fff;font-size:22px;font-weight:700;letter-spacing:-0.3px;'>Deployment Successful</h1><p style='margin:5px 0 0;color:rgba(255,255,255,0.8);font-size:13px;'>BMI Health Tracker &mdash; Build <strong>#${BUILD_NUMBER}</strong></p></td><td align='right'><span style='background:rgba(255,255,255,0.15);color:#fff;padding:4px 14px;border-radius:20px;font-size:12px;font-weight:600;'>${env.DEPLOY_MODE}</span></td></tr></table></td></tr><tr><td style='padding:28px 36px;'><table width='100%' cellpadding='0' cellspacing='0' style='border-radius:8px;overflow:hidden;border:1px solid #e5e9f0;font-size:14px;'><tr style='background:#f7f9fc;'><td colspan='2' style='padding:10px 16px;color:#6b7280;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;border-bottom:1px solid #e5e9f0;'>Deployment Details</td></tr><tr><td style='padding:12px 16px;color:#6b7280;border-bottom:1px solid #f0f3f8;width:110px;font-size:13px;'>Job</td><td style='padding:12px 16px;color:#1a1a2e;font-weight:600;border-bottom:1px solid #f0f3f8;font-size:13px;'>${JOB_NAME}</td></tr><tr style='background:#fafbfd;'><td style='padding:12px 16px;color:#6b7280;border-bottom:1px solid #f0f3f8;font-size:13px;'>Build</td><td style='padding:12px 16px;border-bottom:1px solid #f0f3f8;'><span style='background:#dcfce7;color:#15803d;padding:2px 12px;border-radius:20px;font-size:12px;font-weight:700;'>#${BUILD_NUMBER}</span></td></tr><tr><td style='padding:12px 16px;color:#6b7280;border-bottom:1px solid #f0f3f8;font-size:13px;'>Target</td><td style='padding:12px 16px;color:#1a1a2e;font-weight:600;border-bottom:1px solid #f0f3f8;font-size:13px;'>${params.EC2_HOST}</td></tr><tr style='background:#fafbfd;'><td style='padding:12px 16px;color:#6b7280;border-bottom:1px solid #f0f3f8;font-size:13px;'>App URL</td><td style='padding:12px 16px;border-bottom:1px solid #f0f3f8;'><a href='http://${params.EC2_HOST}' style='color:#2563eb;text-decoration:none;font-weight:600;font-size:13px;'>http://${params.EC2_HOST} &#8599;</a></td></tr><tr><td style='padding:12px 16px;color:#6b7280;font-size:13px;'>Console</td><td style='padding:12px 16px;'><a href='${BUILD_URL}console' style='color:#2563eb;text-decoration:none;font-weight:600;font-size:13px;'>View Console Output &#8599;</a></td></tr></table><table width='100%' style='margin-top:22px;'><tr><td align='center'><a href='http://${params.EC2_HOST}' style='display:inline-block;background:#1a6b2f;color:#fff;text-decoration:none;padding:12px 36px;border-radius:7px;font-size:14px;font-weight:700;letter-spacing:0.2px;'>Open Application &#8594;</a></td></tr></table></td></tr><tr><td style='padding:14px 36px;background:#f7f9fc;border-top:1px solid #e5e9f0;'><p style='margin:0;font-size:11px;color:#a0aec0;text-align:center;letter-spacing:0.3px;'>Jenkins CI &bull; AWS SES via IAM Role &bull; ${AWS_SES_REGION} &bull; BMI Health Tracker DevOps Course</p></td></tr></table></td></tr></table></body></html>","Charset":"UTF-8"}}}
SESEOF
                        export PATH=\$PATH:/usr/local/bin:/usr/bin
                        aws ses send-email \\
                            --from "${params.FROM_EMAIL}" \\
                            --destination "ToAddresses=${params.NOTIFY_EMAIL}" \\
                            --message file:///tmp/bmi_ses_msg.json \\
                            --region "${AWS_SES_REGION}"
                        rm -f /tmp/bmi_ses_msg.json
                    """
                    echo "Email notification sent to: ${params.NOTIFY_EMAIL}"
                } catch (sesEx) {
                    echo "[WARN] SES email failed — ensure IAM role has ses:SendEmail and FROM_EMAIL is verified in SES. Error: ${sesEx.message}"
                }
            }
        }

        failure {
            script {
                echo "[FAILURE] Deployment failed — Build #${BUILD_NUMBER} — review console output above"

                try {
                    sh """
                        cat > /tmp/bmi_ses_msg.json << 'SESEOF'
{"Subject":{"Data":"[FAILED] BMI Health Tracker — Build #${BUILD_NUMBER} Failed","Charset":"UTF-8"},"Body":{"Text":{"Data":"Deployment Failed\\nJob: ${JOB_NAME}\\nBuild: #${BUILD_NUMBER}\\nTarget: ${params.EC2_HOST}\\nConsole: ${BUILD_URL}console\\nReview the console output for full error details.","Charset":"UTF-8"},"Html":{"Data":"<html><body style='margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Arial,sans-serif;background:#eef2f7;'><table width='100%' cellpadding='0' cellspacing='0'><tr><td align='center' style='padding:30px 20px;'><table width='580' cellpadding='0' cellspacing='0' style='background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.09);'><tr><td style='background:#b91c1c;padding:28px 36px;'><table width='100%'><tr><td style='font-size:32px;width:48px;'>&#10060;</td><td style='padding-left:14px;'><h1 style='margin:0;color:#fff;font-size:22px;font-weight:700;letter-spacing:-0.3px;'>Deployment Failed</h1><p style='margin:5px 0 0;color:rgba(255,255,255,0.8);font-size:13px;'>BMI Health Tracker &mdash; Build <strong>#${BUILD_NUMBER}</strong></p></td><td align='right'><span style='background:rgba(255,255,255,0.15);color:#fff;padding:4px 14px;border-radius:20px;font-size:12px;font-weight:600;'>FAILED</span></td></tr></table></td></tr><tr><td style='padding:28px 36px;'><table width='100%' cellpadding='0' cellspacing='0' style='border-radius:8px;overflow:hidden;border:1px solid #e5e9f0;font-size:14px;'><tr style='background:#f7f9fc;'><td colspan='2' style='padding:10px 16px;color:#6b7280;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.8px;border-bottom:1px solid #e5e9f0;'>Failure Details</td></tr><tr><td style='padding:12px 16px;color:#6b7280;border-bottom:1px solid #f0f3f8;width:110px;font-size:13px;'>Job</td><td style='padding:12px 16px;color:#1a1a2e;font-weight:600;border-bottom:1px solid #f0f3f8;font-size:13px;'>${JOB_NAME}</td></tr><tr style='background:#fafbfd;'><td style='padding:12px 16px;color:#6b7280;border-bottom:1px solid #f0f3f8;font-size:13px;'>Build</td><td style='padding:12px 16px;border-bottom:1px solid #f0f3f8;'><span style='background:#fee2e2;color:#b91c1c;padding:2px 12px;border-radius:20px;font-size:12px;font-weight:700;'>#${BUILD_NUMBER}</span></td></tr><tr><td style='padding:12px 16px;color:#6b7280;border-bottom:1px solid #f0f3f8;font-size:13px;'>Target</td><td style='padding:12px 16px;color:#1a1a2e;font-weight:600;border-bottom:1px solid #f0f3f8;font-size:13px;'>${params.EC2_HOST}</td></tr><tr style='background:#fafbfd;'><td style='padding:12px 16px;color:#6b7280;font-size:13px;'>Console</td><td style='padding:12px 16px;'><a href='${BUILD_URL}console' style='color:#2563eb;text-decoration:none;font-weight:600;font-size:13px;'>View Console Output &#8599;</a></td></tr></table><div style='margin-top:20px;padding:14px 18px;background:#fff5f5;border-left:4px solid #b91c1c;border-radius:0 6px 6px 0;'><p style='margin:0;font-size:13px;color:#7f1d1d;font-weight:500;'>&#9888; Review the console output above for the full error details and stack trace.</p></div><table width='100%' style='margin-top:22px;'><tr><td align='center'><a href='${BUILD_URL}console' style='display:inline-block;background:#b91c1c;color:#fff;text-decoration:none;padding:12px 36px;border-radius:7px;font-size:14px;font-weight:700;letter-spacing:0.2px;'>View Console Output &#8594;</a></td></tr></table></td></tr><tr><td style='padding:14px 36px;background:#f7f9fc;border-top:1px solid #e5e9f0;'><p style='margin:0;font-size:11px;color:#a0aec0;text-align:center;letter-spacing:0.3px;'>Jenkins CI &bull; AWS SES via IAM Role &bull; ${AWS_SES_REGION} &bull; BMI Health Tracker DevOps Course</p></td></tr></table></td></tr></table></body></html>","Charset":"UTF-8"}}}
SESEOF
                        export PATH=\$PATH:/usr/local/bin:/usr/bin
                        aws ses send-email \\
                            --from "${params.FROM_EMAIL}" \\
                            --destination "ToAddresses=${params.NOTIFY_EMAIL}" \\
                            --message file:///tmp/bmi_ses_msg.json \\
                            --region "${AWS_SES_REGION}"
                        rm -f /tmp/bmi_ses_msg.json
                    """
                    echo "Failure notification sent to: ${params.NOTIFY_EMAIL}"
                } catch (sesEx) {
                    echo "[WARN] SES email failed — ensure IAM role has ses:SendEmail and FROM_EMAIL is verified in SES. Error: ${sesEx.message}"
                }
            }
        }

        always {
            echo "Pipeline done | Build: #${BUILD_NUMBER} | Mode: ${env.DEPLOY_MODE ?: 'N/A'} | Target: ${params.EC2_HOST ?: 'N/A'} | Node: ${NODE_NAME}"
        }
    }
}
