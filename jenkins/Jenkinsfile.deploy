// ============================================================
// BMI Health Tracker — Bare-Metal Deploy Pipeline (SL#5)
// Deploys to AWS Ubuntu 24.04 EC2 via SSH
//
// Smart idempotent logic:
//   Run 1 (fresh EC2) → installs everything from scratch
//   Run 2+ (existing)  → backs up current deployment, pulls latest, redeploys
//
// Required Jenkins Credentials:
//   ec2-ssh-key        → SSH Username with private key (EC2 .pem file)
//   bmi-database-url   → Secret text (postgresql://bmi_user:PASS@localhost:5432/bmidb)
//
// Required Plugins:
//   SSH Agent, Email Extension, Credentials Binding
// ============================================================

pipeline {
    agent { label 'built-in' }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 40, unit: 'MINUTES')
        ansiColor('xterm')
    }

    parameters {
        string(
            name: 'EC2_HOST',
            defaultValue: '',
            description: 'EC2 Public IP or hostname (required)'
        )
        string(
            name: 'EC2_USER',
            defaultValue: 'ubuntu',
            description: 'SSH username on the EC2 instance'
        )
        string(
            name: 'SSH_CREDENTIALS_ID',
            defaultValue: 'ec2-ssh-key',
            description: 'Jenkins Credential ID containing the EC2 SSH private key'
        )
        string(
            name: 'NOTIFY_EMAIL',
            defaultValue: '',
            description: 'Email address for deployment notifications (required)'
        )
    }

    environment {
        APP_DIR    = '/home/ubuntu/bmi-health-tracker'
        BACKUP_DIR = '/home/ubuntu/backups'
        WEBROOT    = '/var/www/bmi-health-tracker'
        GIT_REPO   = 'https://github.com/sarowar-alam/devops-jenkins-masterclass.git'
        MARKER     = '/home/ubuntu/bmi-health-tracker/.deployed'
    }

    stages {

        // --------------------------------------------------------
        // Stage 1: Checkout
        // --------------------------------------------------------
        stage('Checkout') {
            steps {
                checkout scm
                echo "Source code checked out on Jenkins master — Build #${BUILD_NUMBER}"
            }
        }

        // --------------------------------------------------------
        // Stage 2: Validate Parameters
        // --------------------------------------------------------
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.EC2_HOST?.trim()) {
                        error("EC2_HOST is required. Provide the EC2 public IP or hostname.")
                    }
                    if (!params.NOTIFY_EMAIL?.trim()) {
                        error("NOTIFY_EMAIL is required. Provide an email address for notifications.")
                    }
                    echo "Target server  : ${params.EC2_USER}@${params.EC2_HOST}"
                    echo "Notification   : ${params.NOTIFY_EMAIL}"
                    echo "Credential ID  : ${params.SSH_CREDENTIALS_ID}"
                }
            }
        }

        // --------------------------------------------------------
        // Stage 3: Pre-flight Check
        // Detects whether this is a fresh deploy or an update
        // --------------------------------------------------------
        stage('Pre-flight Check') {
            steps {
                script {
                    sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                        def result = sh(
                            script: """
                                ssh -o StrictHostKeyChecking=no \
                                    -o ConnectTimeout=30 \
                                    ${params.EC2_USER}@${params.EC2_HOST} \
                                    'test -f ${MARKER} && echo EXISTS || echo FRESH'
                            """,
                            returnStdout: true
                        ).trim()

                        env.DEPLOY_MODE = result
                        echo "============================================"
                        echo " Deployment mode : ${env.DEPLOY_MODE}"
                        if (env.DEPLOY_MODE == 'FRESH') {
                            echo " Action          : Full installation"
                        } else {
                            echo " Action          : Backup + update"
                        }
                        echo "============================================"
                    }
                }
            }
        }

        // --------------------------------------------------------
        // Stage 4A: Fresh Install
        // Runs ONLY when no .deployed marker found
        // --------------------------------------------------------
        stage('Fresh Install') {
            when {
                expression { env.DEPLOY_MODE == 'FRESH' }
            }
            steps {
                sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                    withCredentials([
                        string(credentialsId: 'bmi-database-url', variable: 'DATABASE_URL')
                    ]) {
                        sh """
                            ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} bash -s << 'REMOTE_SCRIPT'
                                set -euo pipefail
                                echo "=== [FRESH INSTALL] Starting ==="

                                # System update
                                sudo apt-get update -qq
                                sudo apt-get install -y git curl

                                # Node.js 20.x via NodeSource
                                if ! command -v node &>/dev/null; then
                                    echo "Installing Node.js 20.x..."
                                    curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash -
                                    sudo apt-get install -y nodejs
                                fi
                                echo "Node.js: \$(node --version) | npm: \$(npm --version)"

                                # Nginx
                                sudo apt-get install -y nginx
                                sudo systemctl enable nginx

                                # PM2 globally
                                sudo npm install -g pm2

                                # PostgreSQL 14 via official PGDG repo
                                # (Ubuntu 24.04 default repos only ship PG16 — PGDG has PG14)
                                if ! command -v psql &>/dev/null; then
                                    echo "Installing PostgreSQL 14 via PGDG..."
                                    sudo apt-get install -y gnupg2 wget
                                    sudo install -d /usr/share/postgresql-common/pgdg
                                    sudo wget -q -O /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
                                        https://www.postgresql.org/media/keys/ACCC4CF8.asc
                                    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt noble-pgdg main" \
                                        | sudo tee /etc/apt/sources.list.d/pgdg.list
                                    sudo apt-get update -qq
                                    sudo apt-get install -y postgresql-14 postgresql-contrib-14
                                fi
                                sudo systemctl enable postgresql
                                sudo systemctl start postgresql

                                # Create backup directory
                                mkdir -p ${BACKUP_DIR}

                                echo "=== [FRESH INSTALL] System packages ready ==="
REMOTE_SCRIPT
                        """

                        sh """
                            ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} bash -s << 'REMOTE_SCRIPT'
                                set -euo pipefail

                                # Clone repository
                                echo "=== [FRESH INSTALL] Cloning repository ==="
                                sudo rm -rf ${APP_DIR}
                                git clone ${GIT_REPO} ${APP_DIR}
                                echo "Cloned to: ${APP_DIR}"
                                cd ${APP_DIR}
                                git log --oneline -3

                                echo "=== [FRESH INSTALL] Setting up database ==="
                                sudo systemctl start postgresql

                                # Extract password from DATABASE_URL (Groovy expands ${DATABASE_URL} at build time)
                                DB_PASS=\$(python3 -c "from urllib.parse import urlparse; print(urlparse('${DATABASE_URL}').password)")

                                # Create user if not exists
                                if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='bmi_user'" | grep -q 1; then
                                    sudo -u postgres psql -c "CREATE USER bmi_user WITH PASSWORD '\$DB_PASS';"
                                    echo "User bmi_user created"
                                fi

                                # Create database if not exists
                                if ! sudo -u postgres psql -lqt | cut -d '|' -f 1 | grep -qw bmidb; then
                                    sudo -u postgres psql -c "CREATE DATABASE bmidb OWNER bmi_user;"
                                    echo "Database bmidb created"
                                fi

                                # Grant privileges
                                sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE bmidb TO bmi_user;"
                                sudo -u postgres psql -d bmidb -c "GRANT ALL ON SCHEMA public TO bmi_user;" 2>/dev/null || true
                                sudo -u postgres psql -d bmidb -c "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO bmi_user;" 2>/dev/null || true
                                sudo -u postgres psql -d bmidb -c "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO bmi_user;" 2>/dev/null || true

                                # Allow password auth for bmi_user in pg_hba.conf
                                PG_HBA=\$(sudo -u postgres psql -tAc "SHOW hba_file" | tr -d '[:space:]')
                                if ! sudo grep -q "bmi_user" "\$PG_HBA"; then
                                    printf "\nhost bmidb bmi_user 127.0.0.1/32 scram-sha-256\nhost bmidb bmi_user ::1/128 scram-sha-256\n" | sudo tee -a "\$PG_HBA"
                                    sudo systemctl reload postgresql
                                    echo "pg_hba.conf updated for bmi_user"
                                fi

                                # Run migrations — copy to /tmp first so postgres user can read them
                                # (postgres user cannot traverse /home/ubuntu/ — Permission denied)
                                cp ${APP_DIR}/backend/migrations/001_create_measurements.sql /tmp/
                                cp ${APP_DIR}/backend/migrations/002_add_measurement_date.sql /tmp/
                                sudo -u postgres psql -d bmidb -f /tmp/001_create_measurements.sql
                                sudo -u postgres psql -d bmidb -f /tmp/002_add_measurement_date.sql
                                rm -f /tmp/001_create_measurements.sql /tmp/002_add_measurement_date.sql
                                echo "Migrations complete"
REMOTE_SCRIPT
                        """

                        // Inject DATABASE_URL from Jenkins credential into the remote .env
                        sh """
                            ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} '
                                set -euo pipefail

                                echo "=== [FRESH INSTALL] Configuring backend ==="
                                cd ${APP_DIR}/backend
                                npm install --omit=dev

                                # Write .env file
                                cat > ${APP_DIR}/backend/.env << EOF
PORT=3000
DATABASE_URL=${DATABASE_URL}
NODE_ENV=production
FRONTEND_URL=http://${params.EC2_HOST}
EOF
                                echo ".env created"

                                # Start with PM2
                                pm2 start ecosystem.config.js
                                pm2 save
                                sudo env PATH=\$PATH:/usr/bin pm2 startup systemd -u ubuntu --hp /home/ubuntu
                                echo "PM2 started — bmi-backend"

                                echo "=== [FRESH INSTALL] Building frontend ==="
                                cd ${APP_DIR}/frontend
                                npm install
                                npm run build
                                echo "Frontend built — dist/ ready"

                                echo "=== [FRESH INSTALL] Deploying frontend to Nginx ==="
                                sudo mkdir -p ${WEBROOT}
                                sudo cp -r ${APP_DIR}/frontend/dist/* ${WEBROOT}/
                                sudo chown -R www-data:www-data ${WEBROOT}

                                # Write Nginx virtual host config
                                sudo tee /etc/nginx/sites-available/bmi-health-tracker > /dev/null << NGINXEOF
server {
    listen 80;
    server_name _;

    root ${WEBROOT};
    index index.html;

    # React SPA routing — serve index.html for all non-file routes
    location / {
        try_files \\\$uri \\\$uri/ /index.html;
    }

    # Proxy API requests to Node.js backend
    location /api {
        proxy_pass         http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              \\\$host;
        proxy_set_header   X-Real-IP         \\\$remote_addr;
        proxy_set_header   X-Forwarded-For   \\\$proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
        proxy_read_timeout 60s;
    }
}
NGINXEOF

                                sudo ln -sf /etc/nginx/sites-available/bmi-health-tracker \
                                            /etc/nginx/sites-enabled/bmi-health-tracker
                                sudo rm -f /etc/nginx/sites-enabled/default
                                sudo nginx -t
                                sudo systemctl reload nginx
                                echo "Nginx configured and reloaded"

                                # Write deployment marker
                                echo "Deployed: \$(date -u +%Y-%m-%dT%H:%M:%SZ) | Build: ${BUILD_NUMBER} | Mode: FRESH" \
                                    > ${MARKER}
                                echo "=== [FRESH INSTALL] Complete ==="
                            '
                        """
                    }
                }
            }
        }

        // --------------------------------------------------------
        // Stage 4B: Update Existing Deployment
        // Runs ONLY when .deployed marker exists
        // --------------------------------------------------------
        stage('Update Existing Deployment') {
            when {
                expression { env.DEPLOY_MODE == 'EXISTS' }
            }
            steps {
                sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} '
                            set -euo pipefail
                            TIMESTAMP=\$(date +%Y%m%d-%H%M%S)
                            BACKUP_PATH=${BACKUP_DIR}/bmi-\${TIMESTAMP}

                            echo "=== [UPDATE] Creating backup at \${BACKUP_PATH} ==="
                            mkdir -p \${BACKUP_PATH}

                            # Backup current source directories
                            cp -r ${APP_DIR}/backend/src   \${BACKUP_PATH}/backend-src   2>/dev/null || true
                            cp -r ${APP_DIR}/frontend/src  \${BACKUP_PATH}/frontend-src  2>/dev/null || true

                            # Backup current served frontend build
                            sudo cp -r ${WEBROOT} \${BACKUP_PATH}/dist-backup 2>/dev/null || true

                            # Record what is being backed up
                            echo "Backup of build: \$(cat ${MARKER} 2>/dev/null || echo unknown)" \
                                > \${BACKUP_PATH}/backup-info.txt

                            echo "Backup complete: \${BACKUP_PATH}"

                            echo "=== [UPDATE] Pulling latest code ==="
                            cd ${APP_DIR}
                            git fetch origin
                            git reset --hard origin/main
                            echo "Updated to: \$(git log --oneline -1)"

                            echo "=== [UPDATE] Updating backend dependencies ==="
                            cd ${APP_DIR}/backend
                            npm install --omit=dev

                            echo "=== [UPDATE] Rebuilding frontend ==="
                            cd ${APP_DIR}/frontend
                            npm install
                            npm run build
                            echo "Frontend rebuilt"

                            echo "=== [UPDATE] Deploying new frontend build ==="
                            sudo cp -r ${APP_DIR}/frontend/dist/* ${WEBROOT}/
                            sudo chown -R www-data:www-data ${WEBROOT}

                            echo "=== [UPDATE] Restarting backend ==="
                            pm2 restart bmi-backend
                            echo "PM2 restart: bmi-backend done"

                            echo "=== [UPDATE] Reloading Nginx ==="
                            sudo nginx -t
                            sudo systemctl reload nginx
                            echo "Nginx reloaded"

                            # Update deployment marker
                            echo "Deployed: \$(date -u +%Y-%m-%dT%H:%M:%SZ) | Build: ${BUILD_NUMBER} | Mode: UPDATE | Backup: \${BACKUP_PATH}" \
                                > ${MARKER}

                            echo "=== [UPDATE] Complete ==="
                        '
                    """
                }
            }
        }

        // --------------------------------------------------------
        // Stage 5: Health Check
        // --------------------------------------------------------
        stage('Health Check') {
            steps {
                script {
                    sshagent(credentials: [params.SSH_CREDENTIALS_ID]) {
                        sh """
                            echo "Waiting 15 seconds for services to stabilise..."
                            sleep 15

                            ssh -o StrictHostKeyChecking=no ${params.EC2_USER}@${params.EC2_HOST} '
                                set -euo pipefail
                                echo "=== Health Checks ==="

                                echo "--- Frontend (Nginx port 80) ---"
                                HTTP_CODE=\$(curl -s -o /dev/null -w "%{http_code}" http://localhost)
                                if [ "\$HTTP_CODE" = "200" ]; then
                                    echo "[OK] Frontend responding — HTTP \$HTTP_CODE"
                                else
                                    echo "[FAIL] Frontend returned HTTP \$HTTP_CODE"
                                    exit 1
                                fi

                                echo "--- Backend API (port 3000) ---"
                                API_CODE=\$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/api/measurements)
                                if [ "\$API_CODE" = "200" ]; then
                                    echo "[OK] Backend API responding — HTTP \$API_CODE"
                                else
                                    echo "[FAIL] Backend API returned HTTP \$API_CODE"
                                    exit 1
                                fi

                                echo "--- PM2 Process Status ---"
                                pm2 status

                                echo "--- PostgreSQL Status ---"
                                sudo systemctl is-active postgresql && echo "[OK] PostgreSQL running" || echo "[FAIL] PostgreSQL not running"

                                echo "=== All health checks passed ==="
                            '
                        """
                    }
                }
            }
        }

    } // end stages

    // --------------------------------------------------------
    // Post Actions — Notifications
    // --------------------------------------------------------
    post {
        success {
            script {
                echo "============================================================"
                echo " [SUCCESS] Deployment complete"
                echo " Build     : #${BUILD_NUMBER}"
                echo " Mode      : ${env.DEPLOY_MODE}"
                echo " Target    : ${params.EC2_USER}@${params.EC2_HOST}"
                echo " App URL   : http://${params.EC2_HOST}"
                echo "============================================================"

                try {
                    emailext(
                        from: 'Jenkins CI <sarowar.alam@gmail.com>',
                        to: params.NOTIFY_EMAIL,
                        subject: "[SUCCESS] BMI Health Tracker Deployed - Build #${BUILD_NUMBER}",
                        mimeType: 'text/html',
                        body: """
                            <html><body style="margin:0;padding:0;font-family:Arial,sans-serif;background:#f5f5f5;">
                            <table width="600" cellpadding="0" cellspacing="0" style="margin:20px auto;background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1);">
                              <tr><td style="background:#2c7a2c;padding:20px 24px;">
                                <h2 style="margin:0;color:#fff;">&#10004; Deployment Successful</h2>
                                <p style="margin:4px 0 0;color:#c8ffc8;font-size:13px;">BMI Health Tracker &mdash; Build #${BUILD_NUMBER}</p>
                              </td></tr>
                              <tr><td style="padding:24px;">
                                <table width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;width:130px;"><b>Job</b></td><td style="border:1px solid #ddd;">${JOB_NAME}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Build #</b></td><td style="border:1px solid #ddd;">${BUILD_NUMBER}</td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>Deploy Mode</b></td><td style="border:1px solid #ddd;">${env.DEPLOY_MODE}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Target</b></td><td style="border:1px solid #ddd;">${params.EC2_USER}@${params.EC2_HOST}</td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>App URL</b></td><td style="border:1px solid #ddd;"><a href="http://${params.EC2_HOST}" style="color:#1a73e8;">http://${params.EC2_HOST}</a></td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>API URL</b></td><td style="border:1px solid #ddd;"><a href="http://${params.EC2_HOST}/api/measurements" style="color:#1a73e8;">http://${params.EC2_HOST}/api/measurements</a></td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>Console</b></td><td style="border:1px solid #ddd;"><a href="${BUILD_URL}console" style="color:#1a73e8;">View Console Output</a></td></tr>
                                </table>
                              </td></tr>
                              <tr><td style="padding:12px 24px;background:#f5f5f5;font-size:12px;color:#888;border-top:1px solid #eee;">Sent by Jenkins CI via AWS SES &bull; ap-south-1</td></tr>
                            </table>
                            </body></html>
                        """
                    )
                    echo "Email notification sent to: ${params.NOTIFY_EMAIL}"
                } catch (emailEx) {
                    echo "[WARN] Email notification failed - check SES SMTP config in Manage Jenkins > System > Extended E-mail Notification. Error: ${emailEx.message}"
                }
            }
        }

        failure {
            script {
                echo "[FAILURE] Deployment failed — Build #${BUILD_NUMBER} — review console output above"

                try {
                    emailext(
                        from: 'Jenkins CI <sarowar.alam@gmail.com>',
                        to: params.NOTIFY_EMAIL,
                        subject: "[FAILED] BMI Health Tracker Deployment Failed - Build #${BUILD_NUMBER}",
                        mimeType: 'text/html',
                        body: """
                            <html><body style="margin:0;padding:0;font-family:Arial,sans-serif;background:#f5f5f5;">
                            <table width="600" cellpadding="0" cellspacing="0" style="margin:20px auto;background:#fff;border-radius:6px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.1);">
                              <tr><td style="background:#c0392b;padding:20px 24px;">
                                <h2 style="margin:0;color:#fff;">&#10008; Deployment Failed</h2>
                                <p style="margin:4px 0 0;color:#ffc8c8;font-size:13px;">BMI Health Tracker &mdash; Build #${BUILD_NUMBER}</p>
                              </td></tr>
                              <tr><td style="padding:24px;">
                                <table width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-size:14px;">
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;width:130px;"><b>Job</b></td><td style="border:1px solid #ddd;">${JOB_NAME}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Build #</b></td><td style="border:1px solid #ddd;">${BUILD_NUMBER}</td></tr>
                                  <tr style="background:#f9f9f9;"><td style="border:1px solid #ddd;"><b>Target</b></td><td style="border:1px solid #ddd;">${params.EC2_USER}@${params.EC2_HOST}</td></tr>
                                  <tr><td style="border:1px solid #ddd;"><b>Console</b></td><td style="border:1px solid #ddd;"><a href="${BUILD_URL}console" style="color:#1a73e8;">View Console Output</a></td></tr>
                                </table>
                                <p style="font-size:13px;color:#555;margin-top:16px;">Review the console output for full error details.</p>
                              </td></tr>
                              <tr><td style="padding:12px 24px;background:#f5f5f5;font-size:12px;color:#888;border-top:1px solid #eee;">Sent by Jenkins CI via AWS SES &bull; ap-south-1</td></tr>
                            </table>
                            </body></html>
                        """
                    )
                    echo "Failure notification sent to: ${params.NOTIFY_EMAIL}"
                } catch (emailEx) {
                    echo "[WARN] Email notification failed - check SES SMTP config in Manage Jenkins > System > Extended E-mail Notification. Error: ${emailEx.message}"
                }
            }
        }

        always {
            echo "Pipeline done | Build: #${BUILD_NUMBER} | Mode: ${env.DEPLOY_MODE ?: 'N/A'} | Target: ${params.EC2_HOST ?: 'N/A'} | Node: ${NODE_NAME}"
        }
    }
}
