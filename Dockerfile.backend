# ============================================================
# BMI Health Tracker — Backend Dockerfile
# Single-stage build using Node.js 20 Alpine.
# Installs only production dependencies (no devDependencies).
#
# Built from the backend/ directory:
#   docker build -f Dockerfile.backend -t bmi-backend:latest ./backend
#
# Runtime environment variables (set via docker-compose or .env):
#   PORT          → 3000 (default)
#   DATABASE_URL  → postgresql://bmi_user:PASS@db:5432/bmidb
#   NODE_ENV      → production
#   FRONTEND_URL  → http://<EC2_IP>
# ============================================================

FROM node:20-alpine

LABEL maintainer="DevOps Team"
LABEL description="BMI Health Tracker Backend — Node.js/Express API"
LABEL app="bmi-health-tracker"
LABEL tier="backend"

# Install dumb-init for proper signal handling (PID 1 process manager)
# Without this, CTRL+C / docker stop signals may not reach Node.js correctly
RUN apk add --no-cache dumb-init

# Create a non-root user to run the application
# Running as root inside a container is a security risk
RUN addgroup -g 1001 -S nodejs && \
    adduser  -u 1001 -S nodeuser -G nodejs

WORKDIR /app

# Copy package files first to leverage Docker layer caching
COPY package.json package-lock.json* ./

# Install production dependencies only
# --omit=dev skips nodemon, typescript, and other dev tools
RUN npm ci --omit=dev && \
    npm cache clean --force

# Copy application source code
COPY src/ ./src/

# Copy ecosystem.config.js (used for reference; PM2 not used inside Docker)
COPY ecosystem.config.js ./

# Set ownership to the non-root user
RUN chown -R nodeuser:nodejs /app

# Switch to non-root user
USER nodeuser

# Backend runs on port 3000
EXPOSE 3000

# Health check — verifies the API is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget -qO- http://localhost:3000/api/measurements > /dev/null || exit 1

# Use dumb-init as PID 1 to forward signals properly to Node.js
ENTRYPOINT ["dumb-init", "--"]

# Start the Express server
CMD ["node", "src/server.js"]
