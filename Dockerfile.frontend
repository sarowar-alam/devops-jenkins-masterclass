# ============================================================
# BMI Health Tracker — Frontend Dockerfile
# Multi-stage build:
#   Stage 1 (builder): Node.js 20 Alpine — installs deps and runs vite build
#   Stage 2 (runner):  Nginx Alpine       — serves the static dist/ output
#
# Built from repo root:
#   docker build -f Dockerfile.frontend -t bmi-frontend:latest .
#
# The nginx-frontend.conf handles:
#   - React SPA routing (try_files → /index.html)
#   - API proxy: /api → http://backend:3000 (Docker Compose service name)
# ============================================================

# ── Stage 1: Builder ─────────────────────────────────────────
FROM node:20-alpine AS builder

LABEL stage="builder"
LABEL description="Builds the BMI Health Tracker React frontend"

WORKDIR /app

# Copy only package files first to leverage Docker layer caching.
# If package.json hasn't changed, npm ci is skipped on rebuild.
COPY frontend/package.json frontend/package-lock.json* ./

# Install all dependencies (including devDependencies needed for vite build)
RUN npm ci

# Copy the rest of the frontend source
COPY frontend/ .

# Build the production bundle — output goes to /app/dist/
RUN npm run build

# Verify the build succeeded and list the output
RUN echo "Build output:" && ls -la /app/dist/


# ── Stage 2: Runner ──────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

LABEL maintainer="DevOps Team"
LABEL description="BMI Health Tracker Frontend — Nginx serving React SPA"
LABEL app="bmi-health-tracker"
LABEL tier="frontend"

# Remove the default Nginx configuration
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy our custom Nginx config that handles:
# - SPA routing (try_files → /index.html for React Router)
# - API proxy to backend service on port 3000
COPY nginx/nginx-frontend.conf /etc/nginx/conf.d/bmi-frontend.conf

# Copy the built React app from the builder stage
COPY --from=builder /app/dist/ /usr/share/nginx/html/

# Nginx serves on port 80 by default
EXPOSE 80

# Health check — verify Nginx is serving the app
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/ > /dev/null || exit 1

# Start Nginx in the foreground (required for Docker)
CMD ["nginx", "-g", "daemon off;"]
